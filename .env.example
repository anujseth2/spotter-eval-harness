# Copy to .env and fill in. .env is gitignored, so never commit real values.
#
# NOTE: this file is read directly by src/ts_client.py and is treated as
# authoritative. The OS environment does NOT override it, on purpose: a stale
# exported TS_SECRET_KEY from another cluster in your shell profile would
# otherwise silently shadow this file and produce a misleading auth failure.

# --- ThoughtSpot cluster ---
TS_CLUSTER=https://your-cluster.thoughtspot.cloud
TS_ORG=
TS_TRUSTED_AUTH_USERNAME=you@example.com
# Trusted-auth secret key from Develop > Customizations > Security Settings.
# Leave blank here. Append the real value to your local .env, e.g.:
#   printf 'TS_SECRET_KEY=%s\n' "$SECRET" >> .env
TS_SECRET_KEY=

# --- Grading (LLM-as-judge) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Eval configuration ---
# Who asks these questions. Goes into the judge's system prompt, so make it specific:
# "retail merchandising managers", "clinical operations analysts", "field service planners".
EVAL_DOMAIN=business users

# Titles for the generated workbook.
EVAL_TITLE=Spotter Accuracy Assessment
EVAL_SUBTITLE=Natural-language questions run through Spotter in AUTO_MODE and graded semantically against a domain answer key.
EVAL_SLUG=spotter

# Questions that say "this athlete" / "this customer" / "for him" have no entity to
# resolve when run cold, because in the real app the embedding page supplies it.
# Set this to a real value from the customer's data and those questions are ALSO run
# with it substituted in, which separates analytical accuracy from that UX behaviour.
# Leave blank to skip the second pass.
SUBSTITUTE_ENTITY=
# Comma-separated nouns that mean "the currently selected entity", for your domain.
ENTITY_NOUNS=athlete,player,individual,person,customer,account,store,rep,employee,patient

# If you know which model AUTO_MODE should be picking, put its GUID here and the
# workbook scores routing against it. Leave blank to use the judge's routing call.
EXPECTED_MODEL_GUID=

# Only used by src/auth_diag.py when trying username variants.
TS_EMAIL_DOMAIN=example.com
